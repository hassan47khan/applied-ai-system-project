# Free key from https://aistudio.google.com/apikey (no card needed).
# Without it VibeFinder runs fully offline (TF-IDF retrieval, rule-based parser, template explanations).
GEMINI_API_KEY=your_api_key_here

# Optional second provider: NVIDIA Nemotron. Key from https://build.nvidia.com (starts nvapi-).
# Set VIBEFINDER_LLM=nvidia to make Nemotron understand requests, rerank and write explanations.
# Dense retrieval keeps using the Gemini embedding index either way.
NVIDIA_API_KEY=your_api_key_here

# Optional settings (defaults shown)
# VIBEFINDER_LLM=gemini            # gemini | nvidia
# VIBEFINDER_LLM_MODEL=            # try this model first, e.g. nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
# VIBEFINDER_USE_GEMINI=1          # 0 forces the offline path even with a key
# VIBEFINDER_RETRIEVAL=hybrid      # tfidf | bm25 | dense | hybrid
# VIBEFINDER_RERANK=0              # 1 adds an LLM rerank of the top context cards (chosen provider)
